COMPOSE_PROJECT_NAME=eatlq
TZ=UTC

CLICKHOUSE_DB=eatlq
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me

POSTGRES_DB=eatlq
POSTGRES_USER=eatlq
POSTGRES_PASSWORD=change-me

REDIS_URL=redis://redis:6379/0
MARKET_TICKS_STREAM=market_ticks
MARKET_TICKS_MAXLEN=200000
REDIS_BATCH_SIZE=250
REDIS_BATCH_TIMEOUT_MS=1000
ARCHIVER_GROUP=archiver_group
ARCHIVER_CONSUMER=archiver-1
ARCHIVER_READ_COUNT=250
ARCHIVER_BLOCK_MS=1000
ARCHIVER_PENDING_MIN_IDLE_MS=60000
ARCHIVER_PENDING_RECLAIM_COUNT=250
ARCHIVER_BATCH_SIZE=1000
ARCHIVER_BATCH_TIMEOUT_MS=1000
ARCHIVER_CLICKHOUSE_TABLE=raw_evm_logs
ARCHIVER_HEALTHCHECK_PATH=/tmp/archiver_healthy

CLICKHOUSE_URL=http://clickhouse:8123
POOL_DISCOVERY_CLICKHOUSE_TABLE=discovered_pools
POOL_DISCOVERY_ENABLE_CLICKHOUSE=1

CHAIN_ID=8453
WS_SOURCE=quicknode
EVM_WS_URL=wss://your-provider-endpoint
EVM_HTTP_URL=https://your-provider-endpoint
POOL_DISCOVERY_RPC_URL=https://mainnet.base.org
WS_SUBSCRIBE_METHOD=eth_subscribe
WS_SUBSCRIBE_PARAMS_JSON=["newHeads"]
LOG_FILTER_JSON={"address":["0xd0b53d9277642d899df5c87a3966a349a798f224","0x4c36388be6f416a29c8d8eee81c771ce6be14b18","0x10648ba41b8565907cfa1496765fa4d95390aa0d","0xb4cb800910b228ed3d0834cf79d697127bbb00e5","0xfcd08d68b2313cd5e1d9e0e3f3183ad7cfdbf66f","0x6cdcb1c4a4d1c3c6d054b27ac5b77e89eafb971d","0x82321f3beb69f503380d6b233857d5c43562e2d0","0xdfe5f275020def30993f042174fc2d335678b626","0xbe00ff35af70e8415d0eb605a286d8a45466a4c1","0x7f670f78b17dec44d5ef68a48740b6f8849cc2e6","0x8909Dc15e40173Ff4699343b6eB8132c65e18eC6","0x33128a8fC17869897dcE68Ed026d694621f6FDfD","0x420DD381b31aEf6683db6B902084cB0FFECe40Da","0x5e7BB104d84c7CB9B682AaC2F3d509f5F406809A"],"topics":[["0xc42079f94a6350d7e6235f29174924f928cc2ac818eb64fed8004e115fbcca67","0xd78ad95fa46c994b6551d0da85fc275fe613ce37657fb8d5e3d130840159d822","0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef","0x4c209b5fc8ad50758f13e2e1088ba56a560dff690a1c6fef26394f4c03821c4f","0xdccd412f0b1252819cb1fd330b93224ca42612892bb3f4f789976e6d81936496","0x7a53080ba414158be7ec69b987b5fb7d07dee101fe85488f0853ae16239d0bde","0x0c396cd989a39f4459b5fa1aed6a9a8dcdbc45908acfd67e028cd568da98982c","0xb3e2773606abfd36b5bd91394b3a54d1398336c65005baf7bf7a05efeffaf75b","0x0d3648bd0f6ba80134a33ba9275ac585d9d315f0ad8355cddefde31afa28d0e9","0x783cca1c0412dd0d695e784568c96da2e9c22ff989357a2e8b1d9b2b4e6b7118","0x2128d88d14c80cb081c1252a5acff7a264671bf199ce226b53571b3a693f7ef2"]]}
WS_RECONNECT_INITIAL_BACKOFF_MS=1000
WS_RECONNECT_MAX_BACKOFF_MS=30000
WS_READ_TIMEOUT_SECS=30
RPC_REQUEST_TIMEOUT_SECS=30
BACKFILL_FROM_BLOCK=
BACKFILL_TO_BLOCK=
BACKFILL_CHUNK_SIZE=100
BACKFILL_CONFIRMATIONS=6
BACKFILL_PAUSE_MS=0
BACKFILL_SOURCE_SUFFIX=backfill
BACKFILL_STATE_POSTGRES_URL=postgres://postgres:5432/eatlq
BACKFILL_JOB_NAME=default
BACKFILL_AUTO_CLAIM_PENDING_GAP=true
BACKFILL_SCHEDULER_POLL_INTERVAL_MS=30000
BACKFILL_DISCOVERY_CLICKHOUSE_URL=http://clickhouse:8123
BACKFILL_DISCOVERY_CLICKHOUSE_DB=eatlq
BACKFILL_DISCOVERY_CLICKHOUSE_USER=default
BACKFILL_DISCOVERY_CLICKHOUSE_PASSWORD=change-me
BACKFILL_DISCOVERY_CLICKHOUSE_TABLE=raw_evm_logs
BACKFILL_DISCOVERY_FROM_BLOCK=
BACKFILL_DISCOVERY_TO_BLOCK=
BACKFILL_DISCOVERY_MIN_GAP_SIZE=1
BACKFILL_DISCOVERY_MAX_GAP_SIZE=20
BACKFILL_DISCOVERY_INCLUDE_EDGE_GAPS=false

RAW_CHANNEL_CAPACITY=4096
RECORD_CHANNEL_CAPACITY=4096
INGESTOR_HEALTHCHECK_PATH=/tmp/ingestor_healthy

# Multi-endpoint RPC pools (JSON arrays). Empty = single-URL fallback from EVM_WS_URL / EVM_HTTP_URL.
# Paste into infra/compose/.env right after EVM_HTTP_URL. Wrap in single quotes.
# Example (QuickNode primary + dRPC backup + public HTTP tertiary):
# EVM_WS_URLS_POOL='[{"url":"wss://your-quiknode-endpoint","tier":"day","provider":"quicknode"},{"url":"wss://lb.drpc.org/ogws?network=base&dkey=YOUR_DKEY","tier":"month","provider":"drpc"}]'
# EVM_HTTP_URLS_POOL='[{"url":"https://your-quiknode-endpoint","tier":"day","provider":"quicknode"},{"url":"https://lb.drpc.org/ogrpc?network=base&dkey=YOUR_DKEY","tier":"month","provider":"drpc"},{"url":"https://mainnet.base.org","tier":"month","provider":"base-public"}]'
EVM_WS_URLS_POOL=
EVM_HTTP_URLS_POOL=
WS_CONNECT_TIMEOUT_SECS=10
INGESTOR_STALL_SECS=300
INGESTOR_STALL_GRACE_SECS=120
INGESTOR_WS_IDLE_SECS=120
INGESTOR_POOL_COOLDOWN_SECS=60
INGESTOR_POOL_BAN_SECS=604800
INGESTOR_POOL_MAX_CONSECUTIVE_FAILS=5

RUST_LOG=info,ingestor=debug

# Ingestion mode: sealed (default while QuickNode off) | live (requires budget caps)
EATLQ_INGESTION_MODE=sealed
SWAP_POLLER_INTERVAL_SEC=300
SWAP_POLLER_SKIP_TX_FROM=1
FREE_RPC_URL=https://mainnet.base.org

# RPC budget guard (scripts/maintenance + cron wrappers)
EATLQ_RPC_BUDGET_ENABLED=1
EATLQ_RPC_DAILY_CALL_LIMIT=5000

SIGNALS_STREAM=signals
BASE_CAPITAL=25
STRATEGY_CONSUMER_GROUP=strategy_group
STRATEGY_CONSUMER_NAME=strategy-1
STRATEGY_READ_COUNT=100
STRATEGY_BLOCK_MS=1000
SYSTEM_PANIC_KEY=SYSTEM_PANIC
WHALE_FLOW_THRESHOLD=5000
MODEL_DIR=models
DASHCAM_PATH=logs/dashcam.csv
STRATEGY_TOKEN_BLACKLIST=0x4200000000000000000000000000000000000006,0x833589fcd6edb6e08f4c7c32d4f71b54bda02913,0xd9aaec86b65d86f6a7b5b1b0c42ffa531710b6ca,0x2ae3f1ec7f1f5012cfeab0185bfcb5aa7ac6e90f,0x940181a94a35a4569e4529a3cdfb74e38fd98631,0x4ed4e862860be2ec1f4896764335d5942baadf07
STRATEGY_SYMBOL_BLACKLIST=WETH,USDC,USDbC,cbETH,AERO,DEGEN

# LASZLO-shared gate: both strategy and executor reject signals below this.
SIGNAL_MIN_CONFIDENCE=0.52
STRATEGY_REQUIRE_MANIFEST=0

# Executor (profile: executor) — set EXECUTOR_PRIVATE_KEY on the VPS only; never commit it.
# READ lane: archive + QuoterV2 simulation. SEND lane: MEV-protected tx broadcast only.
EXECUTOR_READ_RPC_URL=
EXECUTOR_READ_RPC_URL_FALLBACK=
EXECUTOR_SEND_RPC_URL=
EXECUTOR_SEND_RPC_URL_FALLBACK=
EXECUTOR_RPC_URL=
EXECUTOR_MEV_PROTECTED=1
EXECUTOR_FRICTION_MIN=-0.05
EXECUTOR_FRICTION_FAIL_CLOSED=1
EXECUTOR_PRIVATE_KEY=
EXECUTOR_DRY_RUN=0
# LIVE_TRADING_MODE: executor startup fail-safe (see docs/executor-language-contract.md).
# For Docker, this must appear under executor `environment:` in compose to reach the container.
LIVE_TRADING_MODE=0
LIVE_AUTHORIZED_BY=
EXECUTOR_CONSUMER_GROUP=execution_group
EXECUTOR_CONSUMER_NAME=executor-1
EXECUTOR_MAX_POSITION_USD=100
EXECUTOR_MAX_BALANCE_FRACTION=0.10
EXECUTOR_MAX_CONCURRENT_POSITIONS=3
EXECUTOR_DAILY_LOSS_PCT=20
EXECUTOR_MAX_GAS_USD=2
EXECUTOR_ETH_PRICE_USD=3500
EXECUTOR_MONITOR_INTERVAL_SEC=5
EXECUTOR_TAKE_PROFIT_PCT=10.0
EXECUTOR_STOP_LOSS_PCT=0.50
EXECUTOR_TRAILING_STOP_PCT=1.0
EXECUTOR_TIME_DECAY_MIN=240

# Signal bridge (profile: executor)
BRIDGE_POLL_SEC=30
BRIDGE_POSITION_SIZE_USD=100
BRIDGE_P_CUT_MAX=0.27

# Telegram notifications — get token from @BotFather, get chat_id by messaging @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Infra watchdog (scripts/keystone_infra_watchdog.py — cron every 30s)
# Layered detection: the <2min SLA for real failures (archiver hang / ingestor
# stop / container death) is carried by the 90s HEARTBEAT + container checks.
# CH_SWAP_LAG is a backstop for "heartbeats alive but no data" and is set above
# normal decode-view jitter (measured 37-85s) to avoid false alarms — do NOT
# lower it back to ~90s or it will flap during healthy operation.
INFRA_WATCHDOG_CH_SWAP_LAG_SEC=150
INFRA_WATCHDOG_INGESTOR_STALE_SEC=90
INFRA_WATCHDOG_ARCHIVER_STALE_SEC=90
INFRA_WATCHDOG_GAP_ALERT_SEC=120
INFRA_WATCHDOG_ALERT_TTL_SEC=600
ARCHIVER_MAX_IDLE_FLUSH_SECS=120

# Smart Money threshold — how many SM wallets must buy before signal fires
SMART_MONEY_BUY_THRESHOLD=2
SMART_MONEY_POOL_MAX_AGE_H=24

# Dashboard (profile: dashboard)
# Recommended: keep it bound to 127.0.0.1 and publish via Nginx/Caddy over HTTPS.
DASHBOARD_BIND=0.0.0.0
DASHBOARD_HOST_BIND=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_BASIC_USER=
DASHBOARD_BASIC_PASS=
DASHBOARD_ACTION_TOKEN=
DASHBOARD_READONLY=0
DASHBOARD_ALLOW_PANIC_ACTIONS=0
DASHBOARD_MAX_SIGNALS=60
DASHBOARD_MAX_SHADOW=120
DASHBOARD_MAX_MARKET_TICKS=1200
DASHBOARD_MAX_MARKET_CANDLES=180
DASHBOARD_INGEST_STALE_SEC=600
DASHBOARD_ARCHIVE_STALE_SEC=1800
